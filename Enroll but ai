import java.io.*;
import java.util.*;

class Database {
    private static final String LOGIN_FILE = "studentLoginDB.csv";
    private static final String STUDENT_FILE = "studentInfo.csv";
    private static final String COURSE_FILE = "courses.csv";

    public Database() {
        createFileIfNotExists(STUDENT_FILE);
        createFileIfNotExists(LOGIN_FILE);
        createFileIfNotExists(COURSE_FILE);
        // Initialize courses if the file is empty
        if (new File(COURSE_FILE).length() == 0) {
            initializeCourses();
        }
    }

    private void createFileIfNotExists(String fileName) {
        File file = new File(fileName);
        try {
            if (file.createNewFile()) {
                System.out.println(fileName + " created.");
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    private void initializeCourses() {
        String[] initialCourses = {"Mathematics", "Science", "English", "History", "Geography"};
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(COURSE_FILE))) {
            for (String course : initialCourses) {
                writer.write(course + "\n");
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public Student addUser(String username, String password, String fullName) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(LOGIN_FILE, true))) {
            writer.write(username + "," + password + "\n");
        } catch (IOException e) {
            e.printStackTrace();
        }

        // Also add user to studentInfo.csv with no courses initially
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(STUDENT_FILE, true))) {
            writer.write(username + "," + fullName + ",\n");
        } catch (IOException e) {
            e.printStackTrace();
        }

        return new Student(username, fullName);
    }

    public Student login(String username, String password) {
        try (BufferedReader reader = new BufferedReader(new FileReader(LOGIN_FILE))) {
            String line;
            while ((line = reader.readLine()) != null) {
                String[] data = line.split(",");
                if (data[0].equals(username) && data[1].equals(password)) {
                    return new Student(username, "");
                }
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
        return null;
    }

    public List<String> readCurrentCourses(String username) {
        List<String> courses = new ArrayList<>();
        try (BufferedReader reader = new BufferedReader(new FileReader(STUDENT_FILE))) {
            String line;
            while ((line = reader.readLine()) != null) {
                String[] data = line.split(",", 3); // Ensure we split only into 3 parts
                if (data[0].equals(username)) {
                    if (data.length > 2 && !data[2].isEmpty()) {
                        courses = new ArrayList<>(Arrays.asList(data[2].split(";")));
                    }
                    break;
                }
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
        return courses;
    }

    public String addCourse(String username, String course) {
        List<String> courses = readCurrentCourses(username);
        if (courses.contains(course)) {
            return "Course already registered.";
        }
        courses.add(course);
        updateStudentCourses(username, courses);
        return "Course added successfully.";
    }

    public String removeCourse(String username, String course) {
        List<String> courses = readCurrentCourses(username);
        if (!courses.contains(course)) {
            return "Course not found.";
        }
        courses.remove(course);
        updateStudentCourses(username, courses);
        return "Course removed successfully.";
    }

    private void updateStudentCourses(String username, List<String> courses) {
        List<String> updatedLines = new ArrayList<>();
        boolean userFound = false;

        try (BufferedReader reader = new BufferedReader(new FileReader(STUDENT_FILE))) {
            String line;
            while ((line = reader.readLine()) != null) {
                String[] data = line.split(",", 3);
                if (data[0].equals(username)) {
                    updatedLines.add(username + "," + (data.length > 1 ? data[1] : "") + "," + String.join(";", courses));
                    userFound = true;
                } else {
                    updatedLines.add(line);
                }
            }
        } catch (IOException e) {
            e.printStackTrace();
        }

        // If user was not found, add them with the courses
        if (!userFound) {
            updatedLines.add(username + ",," + String.join(";", courses));
        }

        try (BufferedWriter writer = new BufferedWriter(new FileWriter(STUDENT_FILE))) {
            for (String updatedLine : updatedLines) {
                writer.write(updatedLine + "\n");
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public List<String> readAvailableCourses() {
        List<String> courses = new ArrayList<>();
        try (BufferedReader reader = new BufferedReader(new FileReader(COURSE_FILE))) {
            String line;
            while ((line = reader.readLine()) != null) {
                courses.add(line);
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
        return courses;
    }
}

class Student {
    private String username;
    private Database database = new Database();

    public Student(String username, String fullName) {
        this.username = username;
    }

    public void showRegistered() {
        List<String> courses = database.readCurrentCourses(username);
        System.out.println("Registered Courses: " + (courses.isEmpty() ? "None" : String.join(", ", courses)));
    }

    public void addCourse(String course) {
        System.out.println(database.addCourse(username, course));
        showRegistered();
    }

    public void deleteCourse(String course) {
        System.out.println(database.removeCourse(username, course));
        showRegistered();
    }
}

public class Main {
    private static Scanner scanner = new Scanner(System.in);
    private static Database database = new Database();

    public static void main(String[] args) {
        Student student = null;
        while (student == null) {
            System.out.println("1. Login\n2. Register\n3. Quit");
            int choice = scanner.nextInt();
            scanner.nextLine();

            if (choice == 1) {
                System.out.print("Username: ");
                String username = scanner.nextLine();
                System.out.print("Password: ");
                String password = scanner.nextLine();
                student = database.login(username, password);
                if (student == null) System.out.println("Invalid credentials, try again.");
            } else if (choice == 2) {
                System.out.print("Username: ");
                String username = scanner.nextLine();
                System.out.print("Password: ");
                String password = scanner.nextLine();
                System.out.print("Full Name: ");
                String fullName = scanner.nextLine();
                student = database.addUser(username, password, fullName);
            } else {
                return;
            }
        }

        while (true) {
            System.out.println("\n1. Show Registered Courses\n2. Add Course\n3. Remove Course\n4. Logout");
            int choice = scanner.nextInt();
            scanner.nextLine();

            if (choice == 1) {
                student.showRegistered();
            } else if (choice == 2) {
                System.out.println("Available Courses:");
                List<String> availableCourses = database.readAvailableCourses();
                for (int i = 0; i < availableCourses.size(); i++) {
                    System.out.println((i + 1) + ". " + availableCourses.get(i));
                }
                System.out.print("Enter the number of the course to add, or type the course name: ");
                String input = scanner.nextLine();
                String course;
                try {
                    int courseNumber = Integer.parseInt(input);
                    if (courseNumber > 0 && courseNumber <= availableCourses.size()) {
                        course = availableCourses.get(courseNumber - 1);
                    } else {
                        System.out.println("Invalid course number.");
                        continue;
                    }
                } catch (NumberFormatException e) {
                    course = input;
                    if (!availableCourses.contains(course)) {
                        System.out.println("Course not available.");
                        continue;
                    }
                }
                student.addCourse(course);
            } else if (choice == 3) {
                System.out.print("Course to Remove: ");
                String course = scanner.nextLine();
                student.deleteCourse(course);
            } else {
                return;
            }
        }
    }
}
